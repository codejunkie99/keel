# Copy to .env and fill in the values you need. Keel does not load this file
# itself. Launch with the variables exported, for example:
#
#   set -a && source .env && set +a && cargo run -p keel --bin keel
#
# Lines below are commented so sourcing this example changes nothing.

# --- 0G Router ---------------------------------------------------------------
# Live catalog and chat completions. Without a key, the 0G row stays disabled
# and auto-route must not place a live 0G call.
# OG_API_KEY=
# Default: https://router-api.0g.ai/v1
# OG_BASE_URL=https://router-api.0g.ai/v1
# Host objective when a request does not set ogObjective. quality | cost | speed
# KEEL_OG_OBJECTIVE=quality
# Host trust when a request does not set ogTrust. standard | verified | private
# KEEL_OG_TRUST=standard

# --- DeepSeek Harness --------------------------------------------------------
# Direct api.deepseek.com path. Independent of OG_API_KEY.
# DEEPSEEK_API_KEY=
# Default: https://api.deepseek.com
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# Override the DeepSeek Harness home. Default: ~/.dsh
# DSH_HOME=

# --- Local Laya --------------------------------------------------------------
# Required for `cargo run` (the packaged app looks in Resources/ instead).
# KEEL_LAYA_WORKER=$PWD/build/laya/dist/laya-worker/laya-worker
# KEEL_LAYA_MODEL=$PWD/build/laya/model
# Packaging only. Directory passed to scripts/package-macos.sh, not read by the app.
# KEEL_LAYA_WORKER_BUNDLE=$PWD/build/laya/dist/laya-worker
# Interpreter for scripts/build-laya-assets.sh. Default: python3.12
# PYTHON_FOR_LAYA=python3.12
# Test-only Python runtime (crates/laya-local). Not the app's worker path.
# LAYA_PYTHON=
# LAYA_MODEL_DIR=

# --- Jev ---------------------------------------------------------------------
# The app reads a protected local TypeSafe credential file, not this variable.
# jev-core honors TYPESAFE_API_KEY only when that config flag is enabled.
# TYPESAFE_API_KEY=

# --- Process -----------------------------------------------------------------
# App state. Default: ~/.keel
# KEEL_DATA_DIR=
# Default harness for chats with no config row.
# mock | codex | cursor | grok | hermes | pi | dsh | og. Default: claude-code
# KEEL_HARNESS=
# Embedded engine port. Default: 27655
# KEEL_IPC_PORT=27655
# WorkOS browser callback port. Default: 27641
# KEEL_CALLBACK_PORT=27641
# Sidebar device label. Default: hostname
# KEEL_DEVICE_NAME=
# Worktree checkouts. Default: under the data dir
# KEEL_WORKTREES_DIR=
# Headless installs apply updates themselves when set to 1, true, or yes.
# KEEL_AUTO_UPDATE=
# Skip the login-shell PATH snapshot used to find CLIs.
# KEEL_NO_LOGIN_SHELL=1
# pi ACP adapter overrides.
# PI_ACP_EXECUTABLE=
# PI_ACP_PI_COMMAND=

# --- Sync and sign-in --------------------------------------------------------
# Local default cannot enable sync: http://127.0.0.1:8787
# KEEL_EDGE_URL=http://127.0.0.1:8787
# Dev bearer / user id. Unset keeps the local signed-out boot.
# KEEL_EDGE_TOKEN=
# Registry room identity. Defaults: dev-org / dev-user
# KEEL_ORG_ID=dev-org
# KEEL_USER_ID=dev-user
# KEEL_WORKOS_CLIENT_ID=
# KEEL_WORKOS_API_BASE=
# Ignored integration tests only (cargo test -- --ignored).
# KEEL_EDGE_WS=ws://127.0.0.1:8787

# --- UI ----------------------------------------------------------------------
# KEEL_DISABLE_NOTIFICATIONS=1
# KEEL_DISABLE_SOUND=1
# Animation scale. Empty or 0 uses the default.
# KEEL_MOTION_SCALE=
# Boot straight into a screen. settings, settings/agents, settings/onboarding,
# settings/devices, settings/harnesses, settings/appearance,
# settings/notifications, settings/shortcuts, settings/archived, new
# KEEL_OPEN_ROUTE=
# Boot with a dialog or menu open. rename | delete | model
# KEEL_OPEN_DIALOG=
# Render an auth gate regardless of real state. signin | org | failed
# KEEL_FORCE_GATE=
# Boot with a picker open. model | traits | branch | checkout | project | device
# KEEL_OPEN_PICKER=
# KEEL_ATTACH=
# KEEL_ATTACH_PREVIEW=1

# --- Runs and diagnostics ----------------------------------------------------
# RUST_LOG=info
# Milliseconds of quiet before a turn is treated as finished. 0 disables it.
# KEEL_TURN_QUIESCE_MS=
# KEEL_SELF_TURN_QUIESCE_MS=
# KEEL_ACP_QUIET_SETTLE_MS=
# KEEL_FRAME_STATS=1
# KEEL_NO_RENDER_CACHE=1
# KEEL_SCROLL_TRACE=1

# --- Mock harness (only when KEEL_HARNESS=mock) -----------------------------
# KEEL_MOCK_DELAY_MS=
# KEEL_MOCK_QUESTION=1
# KEEL_MOCK_REPEAT=
# KEEL_MOCK_ERROR=1
# KEEL_MOCK_TABLE=1
# KEEL_MOCK_CODE=1
# KEEL_MOCK_MEND=1
# KEEL_MOCK_CHARS=
